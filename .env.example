# Gemini Live API Key (used automatically by the web client when set in .env or Cloud Run env vars)
GEMINI_API_KEY=

# Server bind host & port (Cloud Run sets PORT=8080 automatically)
HOST=0.0.0.0
PORT=3000

# Local storage directory for session .json and .srt files (always active in local mode)
DATA_DIR=./data/sessions

# Cloud Deployment Settings (used by ./deploy.sh for Cloud Run, GCS Bucket, & Firestore)
GCP_PROJECT_ID=
GCP_REGION=asia-southeast1
CLOUD_RUN_SERVICE=livetranscribe

# Optional: Google Cloud Storage (GCS) bucket for saving .srt files
GCS_BUCKET=
GCS_PREFIX=livetranscribe/sessions

# Firestore is ONLY enabled on Cloud Run (or when ENABLE_FIRESTORE=true).
# Local deployment works out-of-the-box with local .srt files without Firestore.
ENABLE_FIRESTORE=false
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION=livetranscribe_sessions
